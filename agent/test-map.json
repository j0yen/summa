{
  "schema": "autobuilder.test_map.v1",
  "note": "Generated by onboard-repo.sh from tests/ filenames matching ac<N>_*.rs / ac0N_*.rs (the ac-judge 0.2.1 naming convention). Empty ac_test_map means no such files were found at onboarding time, not that the crate has no tests.",
  "routes": [
    {
      "glob": "src/**",
      "required_proof": [
        "cargo test --workspace"
      ]
    },
    {
      "glob": "Cargo.toml",
      "required_proof": [
        "cargo check --workspace"
      ]
    }
  ],
  "ac_test_map": {
    "AC1": "tests/relevant_ac1_known_item_rank.rs",
    "AC2": "tests/relevant_ac2_no_match.rs",
    "AC3": "tests/relevant_ac3_malformed_skip.rs",
    "AC4": "tests/relevant_ac4_hook_fires_once.rs",
    "AC7": "tests/relevant_ac7_stdin_equivalence.rs",
    "AC8": "tests/relevant_ac8_json_format.rs",
    "AC9": "tests/relevant_ac9_explain.rs"
  }
}
